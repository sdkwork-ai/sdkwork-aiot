# SDKWork private bootstrap credentials (blank in tracked files).
# Resolved tokens belong in ~/.sdkwork/<application-code>/credentials/<profile-id>.json only.

VITE_ACCESS_TOKEN=

# Optional sibling app APIs for agent/voice dialogue
VITE_SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=http://127.0.0.1:18082
VITE_SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
VITE_SDKWORK_AGENTS_APP_API_BASE_URL=http://127.0.0.1:8095
VITE_SDKWORK_VOICE_APP_API_BASE_URL=http://127.0.0.1:18096
VITE_SDKWORK_AIOT_AGENTS_DEFAULT_AGENT_ID=agent.aiot.assistant
VITE_SDKWORK_AIOT_VOICE_DEFAULT_MODEL=tts-1
VITE_SDKWORK_AIOT_VOICE_DEFAULT_VOICE=alloy
VITE_SDKWORK_AIOT_VOICE_TRANSCRIPTION_MODEL=whisper-1

# Private IAM bootstrap access token for local lifecycle commands.
# Keep this blank in the template. The canonical helper writes the real value
# to ~/.sdkwork/<application-code>/credentials/<profile-id>.json.
SDKWORK_ACCESS_TOKEN=

# --- Deploy application identity anchor (required build and runtime input) ---
# The public application access token's `app_id`/`aud` are this installation's
# deploy application id, not a repository-owned runtime id: IAM suppresses a token
# carrying the retired runtime app id. Export the anchor on the build host before
# `pnpm workflow:materialize-client-env`, which rewrites every committed client env
# profile of the declared surfaces with it, and keep it set at runtime.
# The materializer fails, naming this variable, when it is unset or empty, so a
# build can never fall back to a compiled-in application id.
SDKWORK_DEPLOY_APPLICATION_ID=
