{
  "name": "@sdkwork/aiot-pc-console-hardware",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork AIoT user console for Smart Hardware: personal device registry, firmware downloads, and device-to-agent binding.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./service": {
      "types": "./src/hardware-service.ts",
      "import": "./src/hardware-service.ts",
      "default": "./src/hardware-service.ts"
    },
    "./service-default": {
      "types": "./src/hardware-service-default.ts",
      "import": "./src/hardware-service-default.ts",
      "default": "./src/hardware-service-default.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sdkwork/aiot-app-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@sdkwork/aiot-pc-core": "workspace:*",
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "@sdkwork/aiot-pc-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sdkwork/aiot-pc-core": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sdkwork": {
    "workspace": "sdkwork-aiot",
    "product": "sdkwork-aiot",
    "architecture": "pc-console",
    "domain": "hardware",
    "capability": "smart-hardware",
    "status": "ready"
  }
}
